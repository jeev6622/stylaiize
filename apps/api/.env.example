# =============================================================
# StylAIze - Environment Variables
# =============================================================
# Copy this file to apps/api/.env and fill in real values.
# If a service is not configured, the app auto-switches to a
# demo/mock mode and never crashes.
# =============================================================

# -------------------------------------------------------------
# General
# -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the API (used for links, CORS, OAuth redirects)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the frontend (CORS + OAuth callback)
WEB_PUBLIC_URL=http://localhost:3000

# -------------------------------------------------------------
# MongoDB
# -------------------------------------------------------------
# Leave empty to run in in-memory demo mode (no persistence).
MONGODB_URI=mongodb://127.0.0.1:27017/stylaiize
MONGODB_DB_NAME=stylaiize
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/stylaiize

# -------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=stylaiize

# -------------------------------------------------------------
# Google OAuth
# -------------------------------------------------------------
# Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# -------------------------------------------------------------
# Email (SMTP) - used for verification, password reset, alerts
# -------------------------------------------------------------
# Leave empty to use a dev/demo mailer that logs to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StylAIze <no-reply@stylaiize.app>

# -------------------------------------------------------------
# Cloudinary - image storage & optimization
# -------------------------------------------------------------
# Leave empty to use local disk storage (apps/api/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------------
# AI Providers (all optional, abstraction layer)
# -------------------------------------------------------------
# If AI_PROVIDER is empty, StylAIze picks the first provider whose key is
# present, in this order: GEMINI -> OPENAI -> QWEN -> LLAMA -> GEMMA.
#
# Set AI_PROVIDER to pin one provider explicitly. A pinned provider with no
# key is a configuration ERROR: AI endpoints return AI_NOT_CONFIGURED (503)
# rather than quietly serving fake data.
#
# The mock provider is ONLY used when you set AI_PROVIDER=mock on purpose.
AI_PROVIDER=gemini

# Max base64 characters accepted per uploaded image (~6 MB decoded).
AI_MAX_IMAGE_CHARS=8000000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# OpenAI (GPT-4o / vision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Qwen2.5-VL (DashScope)
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-vl-72b-instruct
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Llama Vision (local / RunPod / Modal)
LLAMA_BASE_URL=
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.2-90b-vision

# Gemma (local / RunPod / Modal)
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-3-27b-it

# -------------------------------------------------------------
# Virtual Try-On (IDM-VTON primary, CatVTON fallback)
# -------------------------------------------------------------
# Leave URLs empty until you have deployed a GPU inference server.
# Provider pin: idm_vton | catvton | auto (first configured provider)
VTON_PROVIDER=auto
# Preferred: IDM-VTON FastAPI base URL, e.g. https://<host>:8000
# Enables async jobs and real progress from inference-service/.
VTON_SERVICE_URL=
# Bearer token for the FastAPI service (must match IDM_VTON_SERVICE_API_KEY)
VTON_SERVICE_API_KEY=
# Legacy synchronous IDM-VTON POST endpoint (used when VTON_SERVICE_URL is empty)
VTON_API_URL=
# Optional Bearer token for the legacy IDM-VTON endpoint (server-side only)
VTON_API_KEY=
# Used when the pinned provider is not configured: idm_vton | catvton | none
VTON_FALLBACK_PROVIDER=catvton
# CatVTON POST inference endpoint (placeholder: https://<host>/infer)
VTON_CATVTON_API_URL=
# Optional Bearer token for the CatVTON endpoint (server-side only)
VTON_CATVTON_API_KEY=
# Optional readiness endpoints (defaults to the service/inference URL)
VTON_HEALTH_URL=
VTON_CATVTON_HEALTH_URL=
# Inference timeout for legacy synchronous providers in ms
VTON_TIMEOUT_MS=120000
VTON_HEALTH_TIMEOUT_MS=8000
# Control-plane timeout for async service requests in ms
VTON_SERVICE_REQUEST_TIMEOUT_MS=30000
# Poll interval and maximum wall-clock duration for async jobs (incl. cold start)
VTON_JOB_POLL_MS=2500
VTON_JOB_MAX_MS=600000
# Maximum decoded bytes per uploaded image
VTON_MAX_IMAGE_BYTES=8388608

# -------------------------------------------------------------
# Shopping Engine & Price Alerts
# -------------------------------------------------------------
SHOPPING_ENABLED=true
SHOPPING_API_URL=
SHOPPING_API_KEY=

# -------------------------------------------------------------
# Rate limiting & security
# -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TRUST_PROXY=1

# -------------------------------------------------------------
# Features
# -------------------------------------------------------------
# Master switch for demo/mock mode (auto-enabled when no services)
ALLOW_DEMO_MODE=true
