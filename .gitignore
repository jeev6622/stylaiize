# =============================================================
# StylAIze - Git ignore rules
# Safe examples (*.env.example) are explicitly re-included below.
# =============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files and secrets
.env
.env.*
apps/**/.env
apps/**/.env.*
inference-service/.env
inference-service/.env.*
!.env.example
!.env.sample
!.env.template
!*.env.example

